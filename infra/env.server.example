# Wholesale Scout on the Netcup server: copy to ~/wholesale-scout/.env on the server and fill in.
# chmod 600 .env. Never commit the filled-in file.

# --- Self-hosted Supabase (~/supabase on the server) ---
# The app and Supabase share the host, so go via Caddy's HTTPS name (simplest, works from inside Docker).
SUPABASE_URL=https://db.dgr8cali.co.uk
SUPABASE_SERVICE_KEY=<SERVICE_ROLE_KEY from ~/supabase/.env>
# Migrations / schema backup (npm run migrate), run on the server, not inside the container:
DATABASE_URL=postgresql://postgres.dgr8cali:<POSTGRES_PASSWORD from ~/supabase/.env>@127.0.0.1:5432/postgres

# --- App ---
# Sign-in (passkeys / email links; src/lib/server/auth.ts). Only these addresses can sign in.
AUTH_ALLOWED_EMAILS=akin@dgr8cali.co.uk
# Emergency only: the sign-in page offers it until the first passkey exists, or with AUTH_PASSWORD_FALLBACK=1.
APP_PASSWORD=<same as on Vercel>
# AUTH_PASSWORD_FALLBACK=1
APP_URL=https://ws.dgr8cali.co.uk
CRON_SECRET=<same as on Vercel>
WATCHDOG_SECRET=<same as on Vercel>

# --- Amazon SP-API ---
SPAPI_CLIENT_ID=<same as on Vercel>
SPAPI_CLIENT_SECRET=<same as on Vercel>
SPAPI_REFRESH_TOKEN=<same as on Vercel>
SPAPI_SELLER_ID=<same as on Vercel>
SPAPI_MARKETPLACE_ID=A1F83G8C2ARO7P

# --- Amazon Ads (LWA) ---
ADS_LWA_CLIENT_ID=<same as on Vercel>
ADS_LWA_CLIENT_SECRET=<same as on Vercel>

# --- Keepa / Qogita / Anthropic ---
KEEPA_API_KEY=<same as on Vercel>
QOGITA_EMAIL=<same as on Vercel>
QOGITA_PASSWORD=<same as on Vercel>
ANTHROPIC_API_KEY=<same as on Vercel>

# --- Email (optional): alerts, and sign-in links (those need only RESEND_API_KEY) ---
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Wholesale Scout <login@dgr8cali.co.uk>
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
